rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRegisteredAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function owns(userId) {
      return isRegisteredAccount() && request.auth.uid == userId;
    }

    function isCircleMember(circleId) {
      return isRegisteredAccount()
        && exists(/databases/$(database)/documents/householdCircles/$(circleId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/householdCircles/$(circleId)/members/$(request.auth.uid)).data.accepted == true;
    }

    function hasValidProfileShape(data) {
      return data.keys().hasOnly([
          'email',
          'authProvider',
          'createdAt',
          'updatedAt',
          'personalInfo',
          'medicalInfo',
          'familyCircle',
          'homeLocation',
          'onboardingCompleted',
          'resumeStep'
        ])
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('authProvider' in data)
          || data.authProvider in ['password', 'google.com'])
        && (!('personalInfo' in data) || data.personalInfo is map)
        && (!('medicalInfo' in data) || data.medicalInfo is map)
        && (!('familyCircle' in data) || data.familyCircle is map)
        && (!('homeLocation' in data) || data.homeLocation is map)
        && (!('onboardingCompleted' in data)
          || data.onboardingCompleted is bool)
        && (!('resumeStep' in data)
          || (data.resumeStep is int
            && data.resumeStep >= 1
            && data.resumeStep <= 4));
    }

    // Private profile, onboarding, home-location, and medical data.
    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId)
        && hasValidProfileShape(request.resource.data);
      allow update: if owns(userId)
        && hasValidProfileShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'authProvider',
          'updatedAt',
          'personalInfo',
          'medicalInfo',
          'familyCircle',
          'homeLocation',
          'onboardingCompleted',
          'resumeStep'
        ]);
      allow delete: if false;

      match /settings/{settingsId} {
        allow read, write: if owns(userId);
      }

      match /readiness/{itemId} {
        allow read, write: if owns(userId);
      }

      match /emergencyContacts/{contactId} {
        allow read, write: if owns(userId);
      }

      match /notifications/{notificationId} {
        allow read, delete: if owns(userId);
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt']);
        allow create: if false;
      }
    }

    // Verified public safety content is readable in registered and emergency mode.
    match /publicAlerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /emergencyEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /safePlaces/{placeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /guidance/{guideId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /verifiedReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Submitted reports remain private until the backend publishes a sanitized projection.
    match /incidentReports/{reportId} {
      allow create: if isRegisteredAccount()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isRegisteredAccount() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Circle creation, membership and invitations are backend-only so clients cannot grant access.
    match /householdCircles/{circleId} {
      allow read: if isCircleMember(circleId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isCircleMember(circleId);
        allow create, delete: if false;
        allow update: if isCircleMember(circleId)
          && memberId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastCheckInSafe', 'lastCheckInAt'])
          && request.resource.data.lastCheckInSafe is bool;
      }

      match /checkIns/{checkInId} {
        allow read: if isCircleMember(circleId);
        allow create: if isCircleMember(circleId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /circleInvites/{inviteId} {
      allow read, write: if false;
    }

    match /locationShares/{shareId} {
      allow create: if isRegisteredAccount()
        && request.resource.data.ownerId == request.auth.uid
        && isCircleMember(request.resource.data.circleId)
        && request.resource.data.keys().hasOnly([
          'circleId', 'ownerId', 'location', 'capturedAt', 'expiresAt'
        ])
        && request.resource.data.location.latitude is number
        && request.resource.data.location.longitude is number
        && request.resource.data.location.latitude >= -90
        && request.resource.data.location.latitude <= 90
        && request.resource.data.location.longitude >= -180
        && request.resource.data.location.longitude <= 180
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow read: if isRegisteredAccount()
        && resource.data.expiresAt > request.time
        && (resource.data.ownerId == request.auth.uid
          || isCircleMember(resource.data.circleId));
      allow update: if false;
      allow delete: if isRegisteredAccount()
        && resource.data.ownerId == request.auth.uid;
    }

    match /sosEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid
          || request.auth.uid in resource.data.authorizedUids);
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isRegisteredAccount()
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isRegisteredAccount()
        && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isRegisteredAccount()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // Deny every future collection until it receives feature-specific rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
