{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  },
  "hosting": {
    "site": "resq-106ed",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "resq-106ed",
          "appId": "1:13971597827:android:28dfcba44561fffff83c36",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "resq-106ed",
          "configurations": {
            "android": "1:13971597827:android:28dfcba44561fffff83c36",
            "ios": "1:13971597827:ios:f3f067b37f973e09f83c36",
            "web": "1:13971597827:web:9ece44dfa77b9487f83c36"
          }
        }
      }
    }
  }
}
