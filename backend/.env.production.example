APP_ENV=production
AI_PROVIDER=openai
# Inject secrets through the hosting platform or secret manager. Do not commit them.
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=gpt-5.6-luna
AI_VOICE_MODEL=gpt-realtime-2.1
FIREBASE_PROJECT_ID=your-production-project
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
ALLOWED_ORIGINS=https://resq.app
APP_UNIVERSAL_LINK_BASE=https://resq.app/invite
LOCAL_UPLOAD_DIR=.local/uploads
OBJECT_STORAGE_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.YOUR_REGION.oraclecloud.com
OBJECT_STORAGE_REGION=YOUR_REGION
OBJECT_STORAGE_BUCKET=resq-private-reports
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
NDMA_FEED_URL=
IMD_DISTRICT_WARNING_URL=
IMD_DISTRICT_IDS=
ADMIN_API_KEY=
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30
